# ============ SERVER ============
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# ============ MONGODB ============
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ishjobs?retryWrites=true&w=majority

# ============ JWT ============
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ============ DEEPSEEK AI ============
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_R1_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ WHISPER (OpenAI) ============
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
WHISPER_MODEL=whisper-1

# ============ AISHA AI ============
AISHA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
AISHA_BASE_URL=https://api.aisha.ai/v1

# ============ TELEGRAM BOT ============
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_ADMIN_IDS=

# ============ SECURITY ============
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGIN=*

# ============ UPLOAD ============
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
